{{>layouts/header}}
<!--Content-->
<h1>라이프 트래커 통계창에 오신것을 환영합니다!</h1>

    <div class="form-box">
        <h3 class="text-center mb-4">활동 통계</h3>
        <form action="/lifeTracker/stats/calculate/{{targetDate}}/{{userId}}" method="post">
            <div class="form-group-custom">
                <label>날짜</label>
                <input type="date" class="form-control" name="targetDate">
            </div>
            <button type="submit" class="btn btn-dark">통계 내기(최신화)</button>
        </form>

        <div class="chart-box" style="width: 100%; max-width: 500px; margin: 30px auto;" data-memo="데이터 통계 그래프">
            <canvas id="trackerChart"></canvas>
        </div>

        <a href="/lifeTracker/new/{{targetDate}}/{{userId}}" class="btn btn-outline-secondary w-100 mt-4" style="background-color: #ffe4e1;">기록 추가하러 가기</a>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // 1. 머스태시 반복문을 활용해 자바의 List 데이터를 자바스크립트 배열로 옮겨 담습니다.
        // 컨트롤러에서 "chartDataList"라는 이름의 모델로 넘겨준다고 가정했습니다. (원하시는 이름으로 변경 가능)
        const months = [
        {{#chartDataList}}
            "{{monthN}}월",
        {{/chartDataList}}
        ];

        const times = [
        {{#chartDataList}}
            {{time}},
        {{/chartDataList}}
        ];

        // 2. 도화지 엘리먼트 가져오기
        const ctx = document.getElementById('trackerChart').getContext('2d');

        // 3. Chart.js 설정 및 그리기 실행
        new Chart(ctx, {
            type: 'bar', // 직관적인 막대그래프 형태 (추이를 원하시면 'line'으로 변경 가능!)
            data: {
                labels: months, // 가로축: monthN 매핑
                datasets: [{
                    label: '총 활동 시간 (분)',
                    data: times, // 세로축: time 매핑
                    backgroundColor: 'rgba(75, 192, 192, 0.6)', // 바 내부 색상
                    borderColor: 'rgba(75, 192, 192, 1)',     // 바 테두리 색상
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true // Y축 눈금이 무조건 0부터 시작하도록 고정
                    }
                }
            }
        });
    </script>

{{>layouts/footer}}